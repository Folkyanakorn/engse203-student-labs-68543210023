NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ⭐⭐ Challenge Turso — เว้นว่างไว้ = ใช้ campus.db ในเครื่อง
# ค่าจริงใส่ใน .env (ห้าม commit) หรือใน Environment ของ Render
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ค่าลับสำหรับเซ็น JWT — เว้นว่างไว้ในไฟล์นี้ (ห้ามใส่ค่าจริง)
# สร้างค่าสุ่มใส่ใน api/.env ของเครื่องตัวเอง:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# production (เช่น Render) ตั้งใน Environment ของ service
JWT_SECRET=
JWT_EXPIRES_IN=2h
